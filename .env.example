GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# RapidAPI. Hay que suscribirse ADEMAS de registrarse: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
# Plan gratuito: 200 creditos/mes con limite duro. Se deja margen para diagnostico.
JSEARCH_LIMITE_MENSUAL=180
JSEARCH_PAGINAS=2

# gemini | deepseek
PROVEEDOR_CLASIFICACION=gemini
# Clasificacion: ~100 llamadas/dia. Flash-Lite tiene capa gratuita y es 5x mas
# barato en entrada que Flash. Alternativa aun mas barata: gemini-3.1-flash-lite
MODELO_GEMINI=gemini-3.5-flash-lite
# Extraccion del CV: una sola llamada, multimodal sobre el PDF. Aqui manda la calidad.
MODELO_PERFIL=gemini-3.6-flash
MODELO_DEEPSEEK=deepseek-v4-flash

# Puerto del host donde se publica la web (el 8000 suele estar ocupado)
PUERTO_WEB=8100

# Scrappa sirve ofertas de Indeed. 500 creditos/mes gratis, 1 credito por LLAMADA
# y hasta 20 ofertas por llamada: el mejor ratio del proyecto.
SCRAPPA_API_KEY=
SCRAPPA_LIMITE_MENSUAL=450
# Resultados por llamada (max 100). El credito es el mismo pidas 20 o 100.
SCRAPPA_RESULTADOS=50

RUTA_BD=data/app.db
HORA_RUN_DIARIO=07:00
MAX_CLASIFICACIONES_POR_RUN=200
